# ============================================================
# CoCompute Environment Variables Reference
# Copy this file to .env and fill in your values.
# ============================================================

# ─── Database (Master) ───
DATABASE_URL=postgresql://cocompute:cocompute@localhost:5432/cocompute

# ─── Authentication (Master) ───
# JWT secret — CHANGE THIS in production!
JWT_SECRET_KEY=cocompute-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Worker Authentication (FR-13) ───
# Shared cluster token — must match on both Master and every Worker
WORKER_API_KEY=cocompute-worker-key

# ─── Scheduler (FR-6, FR-14) ───
# Options: round_robin | resource_aware | ai_predictive
SCHEDULER_ALGORITHM=resource_aware
# Workers above this CPU % are completely skipped during scheduling (FR-14)
HIGH_UTILIZATION_THRESHOLD=85.0
# Workers above this RAM % are completely skipped during scheduling (FR-14)
HIGH_RAM_THRESHOLD=90.0

# ─── Fault Recovery (FR-9) ───
# Seconds without a heartbeat before a worker is marked offline
HEARTBEAT_TIMEOUT_SECONDS=15
# Maximum retries for a failed chunk before permanently marking it failed
MAX_RETRIES=3

# ─── AI Scheduler (future scope) ───
AI_MODEL_PATH=/app/model.pkl

# ─── Discovery (FR-1) ───
# IP the master listens on for UDP discovery broadcasts
MASTER_DISCOVERY_IP=0.0.0.0

# ─── Worker Settings ───
# How often the worker sends heartbeat metrics to the master (seconds, FR-3)
HEARTBEAT_INTERVAL=5
# Set to the master's hostname/IP if UDP discovery is not available
MASTER_IP=
MASTER_PORT=8000
# Unique identifier for this worker (auto-generated if not set)
WORKER_UID=
# Path for local SQLite task history DB (FR-11)
WORKER_HISTORY_DB=task_history.db

# ─── Redis Metrics Engine ───
# Redis connection URL for real-time metrics caching and time-series storage
REDIS_URL=redis://localhost:6379/0

# ─── File Storage ───
# Root directory for storing job result files (JSON/CSV exports)
STORAGE_ROOT=./storage

# ─── TLS (optional) ───
USE_TLS=false
TLS_VERIFY=false

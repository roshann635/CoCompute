# ==============================================================================
# CoCompute Comprehensive .gitignore
# ==============================================================================

# Python bytecode & compiled artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.env.local
.env.*.local
*.env
!.env.example
.venv
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
test_model_train.pkl
test_cocompute.db*

# Node / Frontend Dashboard
node_modules/
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases & local persistent storage (including SQLite WAL & SHM files)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
cocompute.db*
task_history.db*
storage/
storage/**
master/app/storage/
master/app/storage/**
results/
results/**
cocompute_artifacts/
cocompute_artifacts/**
minio_data/
redis_data/
checkpoints/

# AI / ML checkpoints, datasets & weights
*.pt
*.pth
*.pkl
*.onnx
*.bin
*.h5
model.pkl

# IDEs & System files
.vscode/
.idea/
.cursor/
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
.project
.settings/

# SSL / TLS Secrets & Certs (preserve structure if .gitkeep exists)
ssl/certs/*
!ssl/certs/.gitkeep
*.pem
*.key
*.crt
*.p12
*.pfx

# CoCompute runtime temp files, logs & artifacts
.cocompute/
.session/
cocompute_outputs/
cocompute_cache/
*.tmp
*.bak
logs/
*.log
*.log.*
brain/
.agents/
.system_generated/
.gemini/
